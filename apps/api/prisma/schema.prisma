datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  TEAM_LEAD
  MEMBER
  GUEST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EdgeKind {
  sequence
  dependency
  related
}

enum ChatScope {
  node
  project
}

enum ConfidentialityLevel {
  PUBLIC_INTERNAL
  INTERNAL
  RESTRICTED
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
}

enum RoleScopeType {
  ORGANIZATION
  DEPARTMENT
  TEAM
  PROJECT
  TASK
}

model Workspace {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  logoUrl       String?      @map("logo_url")
  themeSettings Json?        @default("{}") @map("theme_settings")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  memberships   Membership[]
  projects      Project[]
  nodeTypes     NodeType[]
  statusSets    StatusSet[]
  templates     Template[]
  nodes         Node[]
  edges         Edge[]
  remarks       Remark[]
  chatThreads   ChatThread[]
  documents     Document[]
  auditLogs     AuditLog[]
  rules         AutomationRule[]
  teams         Team[]
  fields        FieldDefinition[]
  notifications Notification[]
  taskApprovals TaskApproval[]
  departments   Department[]
  positions     Position[]
  scopedRoles   ScopedRoleAssignment[]
  accessGrants  AccessGrant[]
  approvalPolicies ApprovalPolicy[]
  approvalRequests ApprovalRequest[]
  auditEvents   AuditEvent[]
  evidenceItems Evidence[]
  workSubmissions WorkSubmission[]
  workUpdates   WorkUpdate[]

  @@map("workspaces")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  phone        String?      @unique
  googleId     String?      @unique @map("google_id")
  passwordHash String?      @map("password_hash")
  fullName     String       @map("full_name")
  avatarUrl    String?      @map("avatar_url")
  locale       String       @default("en")
  isActive     Boolean      @default(true) @map("is_active")
  emailVerified Boolean     @default(true) @map("email_verified")
  phoneVerified Boolean     @default(false) @map("phone_verified")
  tokenVersion Int          @default(1) @map("token_version")
  jobTitle     String?      @map("job_title")
  departmentId String?      @map("department_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  department         Department?             @relation("DepartmentUsers", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments Department[]            @relation("DepartmentManager")
  positions          Position[]              @relation("UserPositions")
  scopedRoles        ScopedRoleAssignment[]  @relation("UserScopedRoles")
  grantedRoles       ScopedRoleAssignment[]  @relation("GrantedScopedRoles")
  accessGrants       AccessGrant[]           @relation("UserAccessGrants")
  grantedAccess      AccessGrant[]           @relation("GrantedAccessGrants")
  ownedProjects      Project[]               @relation("ProjectOwner")
  managedProjects    Project[]               @relation("ProjectManager")
  leadNodes          Node[]                  @relation("NodeLead")
  backupForNodes     Node[]                  @relation("NodeBackupReviewer")
  backupReviewerId   String?                 @map("backup_reviewer_id")
  backupReviewer     User?                   @relation("BackupApprover", fields: [backupReviewerId], references: [id])
  backupForUsers     User[]                  @relation("BackupApprover")

  memberships  Membership[]
  ownedNodes         Node[]          @relation("NodeOwner")
  reviewedNodes      Node[]          @relation("NodeReviewer")
  remarks            Remark[]        @relation("RemarkAuthor")
  messages           ChatMessage[]
  reads              ChatRead[]
  documents          Document[]      @relation("DocumentUploader")
  auditLogs          AuditLog[]      @relation("AuditActor")
  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]
  notifications      Notification[]  @relation("UserNotifications")
  actedNotifications Notification[]  @relation("ActorNotifications")
  assignedNodes          Node[]          @relation("NodeAssignedBy")
  submittedNodes         Node[]          @relation("NodeSubmitter")
  taskApprovalsGiven     TaskApproval[]  @relation("ApprovalReviewer")
  taskApprovalsSubmitted TaskApproval[]  @relation("ApprovalSubmitter")
  submittedWork          WorkSubmission[] @relation("WorkSubmissions")
  workUpdates            WorkUpdate[]    @relation("UserWorkUpdates")
  evidenceItems          Evidence[]      @relation("EvidenceUploader")
  submittedApprovalRequests ApprovalRequest[] @relation("ApprovalRequestSubmitter")
  approvalDecisions      ApprovalDecision[] @relation("UserApprovalDecisions")
  delegatedDecisions     ApprovalDecision[] @relation("UserDelegatedDecisions")
  auditEvents            AuditEvent[]    @relation("UserAuditEvents")
  authIdentities          AuthIdentity[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([isActive])
  @@index([departmentId])
  @@map("users")
}

model Membership {
  id                 String    @id @default(uuid())
  workspaceId        String    @map("workspace_id")
  userId             String    @map("user_id")
  role               Role      @default(MEMBER)
  projectPermissions Json?     @default("{}") @map("project_permissions")
  createdAt          DateTime  @default(now()) @map("created_at")

  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("memberships")
}

model Project {
  id                   String               @id @default(uuid())
  workspaceId          String               @map("workspace_id")
  name                 String
  key                  String?              @map("project_key")
  description          String?
  objectives           String?
  scope                String?
  deliverables         String?
  ownerId              String?              @map("owner_id")
  responsibleManagerId String?              @map("responsible_manager_id")
  departmentId         String?              @map("department_id")
  classification       ConfidentialityLevel @default(INTERNAL)
  accessPolicy         Json?                @default("{}") @map("access_policy")
  templateId           String?              @map("template_id")
  status               String               @default("ACTIVE")
  settings             Json?                @default("{}")
  customData           Json?                @default("{}") @map("custom_data")
  startDate            DateTime?            @map("start_date")
  targetDate           DateTime?            @map("target_date")
  version              Int                  @default(1)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  deletedAt            DateTime?            @map("deleted_at")

  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner                User?                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  responsibleManager   User?                @relation("ProjectManager", fields: [responsibleManagerId], references: [id], onDelete: SetNull)
  department           Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  nodes                Node[]
  edges                Edge[]
  chatThreads          ChatThread[]
  auditLogs            AuditLog[]
  members              ProjectMember[]
  approvalRequests     ApprovalRequest[]

  @@index([workspaceId])
  @@index([workspaceId, key])
  @@index([workspaceId, classification])
  @@map("projects")
}

model NodeType {
  id                 String            @id @default(uuid())
  workspaceId        String            @map("workspace_id")
  key                String
  name               String
  icon               String            @default("Box")
  colour             String            @default("#3b82f6")
  defaultStatusSetId String?           @map("default_status_set_id")
  isGroup            Boolean           @default(false) @map("is_group")
  isSystem           Boolean           @default(false) @map("is_system")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fields             FieldDefinition[]
  nodes              Node[]
  statusSet          StatusSet?        @relation(fields: [defaultStatusSetId], references: [id])

  @@unique([workspaceId, key])
  @@map("node_types")
}

model FieldDefinition {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  nodeTypeId      String?   @map("node_type_id")
  targetType      String    @default("node") @map("target_type") // project | stage | task | node
  fieldKey        String    @map("field_key")
  label           String
  labelI18n       Json?     @default("{}") @map("label_i18n")
  description     String?
  type            String    // text, longtext, number, currency, date, boolean, select, multiselect, user, team, link, file
  required        Boolean   @default(false)
  defaultValue    Json?     @map("default_value")
  options         Json?     @default("{}")
  validation      Json?     @default("{}")
  visibilityRules Json?     @default("[]") @map("visibility_rules")
  groupName       String?   @default("General") @map("group_name")
  displayOrder    Int       @default(0) @map("display_order")
  editableRoles   Json?     @default("[]") @map("editable_roles")
  isActive        Boolean   @default(true) @map("is_active")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodeType        NodeType? @relation(fields: [nodeTypeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, targetType])
  @@index([nodeTypeId, fieldKey])
  @@map("field_definitions")
}

model StatusSet {
  id          String      @id @default(uuid())
  workspaceId String      @map("workspace_id")
  name        String
  isDefault   Boolean     @default(false) @map("is_default")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  statuses    Status[]
  nodeTypes   NodeType[]

  @@map("status_sets")
}

model Status {
  id           String    @id @default(uuid())
  statusSetId  String    @map("status_set_id")
  key          String
  labelI18n    Json      @default("{}") @map("label_i18n")
  colour       String    @default("#94a3b8")
  icon         String    @default("Circle")
  category     String    @default("active") // not_started | active | blocked | done | cancelled
  displayOrder Int       @default(0) @map("display_order")

  statusSet    StatusSet @relation(fields: [statusSetId], references: [id], onDelete: Cascade)
  nodes        Node[]

  @@unique([statusSetId, key])
  @@map("statuses")
}

model Node {
  id           String       @id @default(uuid())
  workspaceId  String       @map("workspace_id")
  projectId    String       @map("project_id")
  parentNodeId String?      @map("parent_node_id")
  nodeTypeId   String       @map("node_type_id")
  statusId     String?      @map("status_id")
  ownerId      String?      @map("owner_id")
  reviewerId   String?      @map("reviewer_id")
  teamId       String?      @map("team_id")
  assignedById String?      @map("assigned_by_id")
  assignedAt   DateTime?    @map("assigned_at")
  submitterId  String?      @map("submitter_id")
  submittedAt  DateTime?    @map("submitted_at")
  title        String
  description  String?
  positionX    Float        @default(0) @map("position_x")
  positionY    Float        @default(0) @map("position_y")
  width        Float        @default(280)
  height       Float        @default(160)
  priority     Priority     @default(MEDIUM)
  weight       Float        @default(1.0)
  isMilestone  Boolean      @default(false) @map("is_milestone")
  milestoneDueDate DateTime? @map("milestone_due_date")
  startDate    DateTime?    @map("start_date")
  dueDate      DateTime?    @map("due_date")
  progressPct  Float        @default(0) @map("progress_pct")
  estimatedCost Decimal?    @map("estimated_cost") @db.Decimal(14, 2)
  actualCost   Decimal?     @map("actual_cost") @db.Decimal(14, 2)
  allocatedHours Decimal?   @map("allocated_hours") @db.Decimal(8, 2)
  actualHours  Decimal?     @map("actual_hours") @db.Decimal(8, 2)
  currency     String?      @default("USD")
  path         String?      @map("path")
  depth        Int          @default(1) @map("depth")
  isRequired   Boolean      @default(true) @map("is_required")
  classification ConfidentialityLevel @default(INTERNAL)
  responsibleLeadId String? @map("responsible_lead_id")
  acceptanceCriteria String? @map("acceptance_criteria")
  definitionOfDone String?  @map("definition_of_done")
  collaboratorIds Json?     @default("[]") @map("collaborator_ids")
  watcherIds   Json?        @default("[]") @map("watcher_ids")
  backupReviewerId String?  @map("backup_reviewer_id")
  approvalStatus String?    @default("not_required") @map("approval_status")
  approvedAt   DateTime?    @map("approved_at")
  approvalFeedback String?  @map("approval_feedback")
  state        String       @default("Draft")
  cadence      String?      @default("immediate")
  checklist    Json?        @default("[]")
  mandatoryEvidenceCount Int @default(0) @map("mandatory_evidence_count")
  customData   Json?        @default("{}") @map("custom_data")
  collapsed    Boolean      @default(false)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentNode   Node?        @relation("NodeNesting", fields: [parentNodeId], references: [id], onDelete: Cascade)
  children     Node[]       @relation("NodeNesting")
  nodeType     NodeType     @relation(fields: [nodeTypeId], references: [id])
  status       Status?      @relation(fields: [statusId], references: [id])
  owner        User?        @relation("NodeOwner", fields: [ownerId], references: [id])
  reviewer     User?        @relation("NodeReviewer", fields: [reviewerId], references: [id])
  team         Team?        @relation("NodeTeam", fields: [teamId], references: [id])
  assignedBy   User?        @relation("NodeAssignedBy", fields: [assignedById], references: [id])
  submitter    User?        @relation("NodeSubmitter", fields: [submitterId], references: [id])
  responsibleLead User?     @relation("NodeLead", fields: [responsibleLeadId], references: [id], onDelete: SetNull)
  backupReviewer User?      @relation("NodeBackupReviewer", fields: [backupReviewerId], references: [id], onDelete: SetNull)

  sourceEdges  Edge[]       @relation("SourceEdges")
  targetEdges  Edge[]       @relation("TargetEdges")
  remarks      Remark[]
  documents    Document[]
  chatThreads  ChatThread[]
  approvals    TaskApproval[]
  submissions  WorkSubmission[]
  workUpdates  WorkUpdate[]
  evidence     Evidence[]
  approvalRequests ApprovalRequest[]

  @@index([projectId, parentNodeId])
  @@index([projectId, path])
  @@index([workspaceId, classification])
  @@index([ownerId, statusId, dueDate])
  @@index([projectId, isMilestone])
  @@index([reviewerId])
  @@index([teamId])
  @@index([submitterId])
  @@index([assignedById])
  @@map("nodes")
}

model Edge {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  projectId    String    @map("project_id")
  sourceNodeId String    @map("source_node_id")
  targetNodeId String    @map("target_node_id")
  kind         EdgeKind  @default(sequence)
  label        String?
  metadata     Json?     @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceNode   Node      @relation("SourceEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   Node      @relation("TargetEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([projectId, sourceNodeId, targetNodeId])
  @@map("edges")
}

model Remark {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  nodeId      String    @map("node_id")
  authorId    String    @map("author_id")
  body        String?
  voiceUrl    String?   @map("voice_url")
  photoUrl    String?   @map("photo_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node        Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  author      User      @relation("RemarkAuthor", fields: [authorId], references: [id])

  @@index([nodeId, createdAt])
  @@map("remarks")
}

model ChatThread {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  projectId   String        @map("project_id")
  scope       ChatScope     @default(node)
  nodeId      String?       @map("node_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node        Node?         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@map("chat_threads")
}

model ChatMessage {
  id                 String       @id @default(uuid())
  threadId           String       @map("thread_id")
  authorId           String       @map("author_id")
  body               String
  attachments        Json?        @default("[]")
  mentions           Json?        @default("[]")
  replyToMessageId   String?      @map("reply_to_message_id")
  editedAt           DateTime?    @map("edited_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  deletedAt          DateTime?    @map("deleted_at")

  thread             ChatThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author             User         @relation(fields: [authorId], references: [id])
  replyTo            ChatMessage? @relation("Replies", fields: [replyToMessageId], references: [id])
  replies            ChatMessage[]@relation("Replies")
  reads              ChatRead[]

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

model ChatRead {
  id                String      @id @default(uuid())
  threadId          String      @map("thread_id")
  userId            String      @map("user_id")
  lastReadMessageId String      @map("last_read_message_id")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message           ChatMessage @relation(fields: [lastReadMessageId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@map("chat_reads")
}

model Document {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  nodeId      String    @map("node_id")
  uploadedBy  String    @map("uploaded_by")
  name        String
  mimeType    String    @map("mime_type")
  fileSize    BigInt    @map("file_size")
  storageKey  String    @map("storage_key")
  category    String    @default("general")
  version     Int       @default(1)
  description String?
  metadata    Json?     @default("{}")
  scanStatus  String    @default("CLEAN") @map("scan_status")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node        Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  uploader    User      @relation("DocumentUploader", fields: [uploadedBy], references: [id])

  @@index([nodeId])
  @@index([workspaceId, category])
  @@map("documents")
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  projectId   String?   @map("project_id")
  entityName  String    @map("entity_name")
  entityId    String    @map("entity_id")
  actorId     String    @map("actor_id")
  action      String    // CREATE | UPDATE | DELETE | STATUS_CHANGE
  oldValues   Json?     @map("old_values")
  newValues   Json?     @map("new_values")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User      @relation("AuditActor", fields: [actorId], references: [id])

  @@index([workspaceId, entityName, entityId])
  @@index([projectId, createdAt])
  @@map("audit_log")
}

model Notification {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  projectId   String?   @map("project_id")
  userId      String    @map("user_id")
  actorId     String?   @map("actor_id")
  type        String    // ASSIGNMENT | DEADLINE_REMINDER | BLOCKER | APPROVAL_REQUEST | APPROVAL_DECISION | COMMENT_MENTION
  title       String
  body        String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  data        Json?     @default("{}")
  read        Boolean   @default(false)
  readAt      DateTime? @map("read_at")
  dedupKey    String?   @map("dedup_key")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor       User?     @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
  @@index([workspaceId, createdAt])
  @@unique([userId, dedupKey])
  @@map("notifications")
}

model Template {
  id              String     @id @default(uuid())
  workspaceId     String?    @map("workspace_id")
  name            String
  category        String     @default("General")
  industry        String     @default("general")
  methodology     String     @default("stage_gate")
  icon            String     @default("Layers")
  tags            Json?      @default("[]")
  description     String?
  graphJson       Json       @map("graph_json")
  defaultSettings Json?      @default("{}") @map("default_settings")
  nodeTypes       Json?      @default("[]") @map("node_types")
  statusSets      Json?      @default("[]") @map("status_sets")
  isPublic        Boolean    @default(true) @map("is_public")
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("templates")
}

model AutomationRule {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  projectId     String?   @map("project_id")
  trigger       String    // status_changed, due_soon, overdue, node_created
  conditions    Json?     @default("{}")
  action        String    // notify, change_status, call_webhook
  actionPayload Json?     @default("{}") @map("action_payload")
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

model Team {
  id          String       @id @default(uuid())
  workspaceId String       @map("workspace_id")
  name        String
  description String?
  colour      String       @default("#3b82f6")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  nodes       Node[]       @relation("NodeTeam")

  @@unique([workspaceId, name])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      String   @default("member") // lead | member
  createdAt DateTime @default(now()) @map("created_at")

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model TaskApproval {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  nodeId      String    @map("node_id")
  submitterId String?   @map("submitter_id")
  submittedAt DateTime? @map("submitted_at")
  reviewerId  String    @map("reviewer_id")
  decision    String    // approved | rejected | changes_requested
  feedback    String?
  decidedAt   DateTime  @default(now()) @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node        Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  submitter   User?     @relation("ApprovalSubmitter", fields: [submitterId], references: [id])
  reviewer    User      @relation("ApprovalReviewer", fields: [reviewerId], references: [id])

  @@index([nodeId, decidedAt])
  @@index([reviewerId])
  @@index([workspaceId, decidedAt])
  @@map("task_approvals")
}

model Department {
  id                 String       @id @default(uuid())
  workspaceId        String       @map("workspace_id")
  name               String
  code               String?
  parentDepartmentId String?      @map("parent_department_id")
  managerId          String?      @map("manager_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  subDepartments     Department[] @relation("DepartmentHierarchy")
  manager            User?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  users              User[]       @relation("DepartmentUsers")
  positions          Position[]
  projects           Project[]
  approvalPolicies   ApprovalPolicy[]

  @@unique([workspaceId, name])
  @@map("departments")
}

model Position {
  id                   String       @id @default(uuid())
  workspaceId          String       @map("workspace_id")
  departmentId         String?      @map("department_id")
  title                String
  reportsToPositionId  String?      @map("reports_to_position_id")
  userId               String?      @map("user_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  workspace            Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department           Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reportsTo            Position?    @relation("PositionReporting", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  subordinates         Position[]   @relation("PositionReporting")
  user                 User?        @relation("UserPositions", fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, departmentId])
  @@map("positions")
}

model ScopedRoleAssignment {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        String
  scope       RoleScopeType @default(ORGANIZATION)
  resourceId  String?       @map("resource_id")
  grantedById String?       @map("granted_by_id")
  expiresAt   DateTime?     @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation("UserScopedRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?         @relation("GrantedScopedRoles", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId, scope, resourceId])
  @@map("scoped_role_assignments")
}

model AccessGrant {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  userId       String    @map("user_id")
  resourceType String    @map("resource_type") // project | task
  resourceId   String    @map("resource_id")
  accessLevel  String    @default("view") @map("access_level") // view | edit
  validUntil   DateTime? @map("valid_until")
  revokedAt    DateTime? @map("revoked_at")
  grantedById  String?   @map("granted_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation("UserAccessGrants", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User?     @relation("GrantedAccessGrants", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId, resourceType, resourceId])
  @@map("access_grants")
}

model WorkSubmission {
  id                String            @id @default(uuid())
  workspaceId       String            @map("workspace_id")
  nodeId            String            @map("node_id")
  version           Int               @default(1)
  submitterId       String            @map("submitter_id")
  summary           String?
  deliverables      String?
  customData        Json?             @default("{}") @map("custom_data")
  metadata          Json?             @default("{}")
  status            String            @default("submitted") // submitted | changes_requested | approved | superseded
  submittedAt       DateTime          @default(now()) @map("submitted_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node              Node              @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  submitter         User              @relation("WorkSubmissions", fields: [submitterId], references: [id], onDelete: Cascade)
  evidence          Evidence[]
  approvalRequests  ApprovalRequest[]

  @@unique([nodeId, version])
  @@index([workspaceId, nodeId])
  @@map("work_submissions")
}

model WorkUpdate {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  nodeId          String    @map("node_id")
  authorId        String    @map("author_id")
  status          String
  progressPct     Float     @default(0) @map("progress_pct")
  doneSinceLast   String?   @map("done_since_last")
  nextPlanned     String?   @map("next_planned")
  blockers        String?
  actualStart     DateTime? @map("actual_start")
  actualFinish    DateTime? @map("actual_finish")
  notes           String?
  links           Json?     @default("[]")
  createdAt       DateTime  @default(now()) @map("created_at")

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node            Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  author          User      @relation("UserWorkUpdates", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  @@map("work_updates")
}

model Evidence {
  id                String           @id @default(uuid())
  workspaceId       String           @map("workspace_id")
  nodeId            String?          @map("node_id")
  submissionId      String?          @map("submission_id")
  submissionVersion Int?             @map("submission_version")
  approvalRequestId String?          @map("approval_request_id")
  uploadedBy        String           @map("uploaded_by")
  name              String
  category          String           @default("general") // permit | certificate | test_results | code_diff | signed_spec | receipt | deliverable | general
  description       String?
  mimeType          String           @map("mime_type")
  fileSize          BigInt           @map("file_size")
  storageKey        String           @map("storage_key")
  fileHash          String?          @map("file_hash")
  metadata          Json?            @default("{}")
  createdAt         DateTime         @default(now()) @map("created_at")
  deletedAt         DateTime?        @map("deleted_at")

  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node              Node?            @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  submission        WorkSubmission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  uploader          User             @relation("EvidenceUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@index([workspaceId, nodeId])
  @@index([submissionId])
  @@index([approvalRequestId])
  @@map("evidence_items")
}

model ApprovalPolicy {
  id                    String            @id @default(uuid())
  workspaceId           String            @map("workspace_id")
  name                  String
  description           String?
  version               Int               @default(1)
  isActive              Boolean           @default(true) @map("is_active")
  isDefault             Boolean           @default(false) @map("is_default")
  
  taskType              String?           @map("task_type")
  projectClassification ConfidentialityLevel? @map("project_classification")
  riskImpact            String?           @map("risk_impact") // LOW | MEDIUM | HIGH | CRITICAL
  budgetThreshold       Decimal?          @map("budget_threshold") @db.Decimal(14, 2)
  confidentiality       ConfidentialityLevel?
  departmentId          String?           @map("department_id")
  operationType         String?           @map("operation_type") // TASK_COMPLETION | DEADLINE_CHANGE | BUDGET_INCREASE | SCOPE_CHANGE | CRITICAL_REASSIGNMENT | RELEASE_PUBLISHING | ACCESS_CHANGE | PRIVILEGE_GRANT | CONFIDENTIALITY_CHANGE | EXCEPTION
  
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department            Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  stages                PolicyStage[]
  requests              ApprovalRequest[]

  @@unique([workspaceId, name, version])
  @@index([workspaceId, operationType])
  @@map("approval_policies")
}

model PolicyStage {
  id                 String          @id @default(uuid())
  policyId           String          @map("policy_id")
  policyVersion      Int             @default(1) @map("policy_version")
  stageOrder         Int             @map("stage_order")
  name               String
  description        String?
  mode               String          @default("SEQUENTIAL") // SEQUENTIAL | PARALLEL
  rule               String          @default("ANY_ONE_APPROVES") // ALL_MUST_APPROVE | ANY_ONE_APPROVES | OPTIONAL | CONDITIONAL
  condition          Json?           @default("{}")
  approverRole       String?         @map("approver_role") // MANAGER | EXECUTIVE | TEAM_LEAD | FINANCE | etc.
  specificApproverId String?         @map("specific_approver_id")
  backupApproverId   String?         @map("backup_approver_id")
  allowDelegation    Boolean         @default(true) @map("allow_delegation")
  dueDurationHours   Int?            @map("due_duration_hours")
  escalateAfterHours Int?            @map("escalate_after_hours")
  escalateToUserId   String?         @map("escalate_to_user_id")

  policy             ApprovalPolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, stageOrder])
  @@map("policy_stages")
}

model ApprovalRequest {
  id                 String                  @id @default(uuid())
  workspaceId        String                  @map("workspace_id")
  projectId          String?                 @map("project_id")
  nodeId             String?                 @map("node_id")
  submissionId       String?                 @map("submission_id")
  submissionVersion  Int                     @default(1) @map("submission_version")
  operationType      String                  @default("TASK_COMPLETION") @map("operation_type")
  policyId           String                  @map("policy_id")
  policyVersion      Int                     @default(1) @map("policy_version")
  submitterId        String                  @map("submitter_id")
  status             String                  @default("PENDING") // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED | WITHDRAWN
  currentStageIndex  Int                     @default(0) @map("current_stage_index")
  payload            Json?                   @default("{}")
  submittedAt        DateTime                @default(now()) @map("submitted_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node               Node?                   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  submission         WorkSubmission?         @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  policy             ApprovalPolicy          @relation(fields: [policyId], references: [id], onDelete: Restrict)
  submitter          User                    @relation("ApprovalRequestSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  stageInstances     ApprovalStageInstance[]
  decisions          ApprovalDecision[]
  evidence           Evidence[]

  @@index([workspaceId, status])
  @@index([nodeId, status])
  @@index([projectId])
  @@map("approval_requests")
}

model ApprovalStageInstance {
  id                  String           @id @default(uuid())
  approvalRequestId   String           @map("approval_request_id")
  stageOrder          Int              @map("stage_order")
  name                String
  mode                String           @default("SEQUENTIAL")
  rule                String           @default("ANY_ONE_APPROVES")
  status              String           @default("PENDING") // PENDING | APPROVED | REJECTED | SKIPPED | CHANGES_REQUESTED
  assignedApproverIds Json?            @default("[]") @map("assigned_approver_ids")
  primaryApproverId   String?          @map("primary_approver_id")
  backupApproverId    String?          @map("backup_approver_id")
  delegatedApproverId String?          @map("delegated_approver_id")
  dueDate             DateTime?        @map("due_date")
  escalatedAt         DateTime?        @map("escalated_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  approvalRequest     ApprovalRequest  @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  decisions           ApprovalDecision[]

  @@index([approvalRequestId, stageOrder])
  @@map("approval_stage_instances")
}

model ApprovalDecision {
  id                  String                 @id @default(uuid())
  approvalRequestId   String                 @map("approval_request_id")
  stageInstanceId     String?                @map("stage_instance_id")
  approverId          String                 @map("approver_id")
  delegatedFromUserId String?                @map("delegated_from_user_id")
  decision            String                 // Approved | Rejected | Changes Requested | Withdrawn
  comment             String?
  policyVersion       Int                    @map("policy_version")
  submissionVersion   Int                    @map("submission_version")
  createdAt           DateTime               @default(now()) @map("created_at")

  approvalRequest     ApprovalRequest        @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  stageInstance       ApprovalStageInstance? @relation(fields: [stageInstanceId], references: [id], onDelete: SetNull)
  approver            User                   @relation("UserApprovalDecisions", fields: [approverId], references: [id], onDelete: Cascade)
  delegatedFromUser   User?                  @relation("UserDelegatedDecisions", fields: [delegatedFromUserId], references: [id], onDelete: SetNull)

  @@unique([approvalRequestId, approverId, submissionVersion])
  @@index([approvalRequestId, stageInstanceId])
  @@index([approverId])
  @@map("approval_decisions")
}

model AuditEvent {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  actorId         String    @map("actor_id")
  action          String    // e.g. TASK_STATE_TRANSITION, WORK_SUBMISSION, APPROVAL_DECISION, PRIVILEGED_OPERATION, SECURITY_VIOLATION
  targetType      String    @map("target_type") // task | project | approval_request | submission | policy
  targetId        String    @map("target_id")
  timestamp       DateTime  @default(now())
  beforeValues    Json?     @map("before_values")
  afterValues     Json?     @map("after_values")
  reason          String?
  requestId       String?   @map("request_id")
  policyReference String?   @map("policy_reference")
  outcome         String    @default("SUCCESS") // SUCCESS | FAILURE | REJECTED | BLOCKED | OVERRIDDEN

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor           User      @relation("UserAuditEvents", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, timestamp])
  @@index([actorId])
  @@map("audit_events")
}

model AuthIdentity {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  provider        String   // google | password | phone
  providerSubject String   @map("provider_subject")
  email           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model OtpChallenge {
  id                String    @id @default(uuid())
  phone             String
  otpHash           String    @map("otp_hash")
  purpose           String    @default("SIGNUP")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5) @map("max_attempts")
  ipAddress         String?   @map("ip_address")
  resendAvailableAt DateTime  @map("resend_available_at")
  expiresAt         DateTime  @map("expires_at")
  verifiedAt        DateTime? @map("verified_at")
  consumed          Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@index([ipAddress])
  @@map("otp_challenges")
}

model PhoneVerificationProof {
  id        String   @id @default(uuid())
  phone     String
  proofHash String   @unique @map("proof_hash")
  consumed  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("phone_verification_proofs")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  consumed  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  consumed  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PendingGoogleSignup {
  id        String   @id @default(uuid())
  googleSub String   @unique @map("google_sub")
  email     String
  fullName  String   @map("full_name")
  avatarUrl String?  @map("avatar_url")
  tokenHash String   @unique @map("token_hash")
  consumed  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("pending_google_signups")
}
