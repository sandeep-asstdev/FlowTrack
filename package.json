{
  "name": "flowtrack-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @flowtrack/api prisma:generate",
    "dev": "npm run dev:web",
    "dev:all": "pnpm --parallel --filter @flowtrack/api --filter @flowtrack/web dev",
    "dev:api": "pnpm --filter @flowtrack/api dev",
    "dev:web": "pnpm --filter @flowtrack/web dev",
    "build:shared": "pnpm --filter @flowtrack/shared build",
    "build": "pnpm --filter @flowtrack/shared build && pnpm --filter @flowtrack/api prisma:generate && pnpm --filter @flowtrack/api build && pnpm --filter @flowtrack/web build",
    "test": "pnpm -r test",
    "lint": "pnpm -r --if-present run lint"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
