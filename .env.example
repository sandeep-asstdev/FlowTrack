# ==========================================
# FlowTrack Monorepo Root Environment Configuration
# ==========================================

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/flowtrack?schema=public"

# API Port & Environment
PORT=3001
NODE_ENV=development

# JWT Secret
JWT_SECRET=flowtrack-super-secret-jwt-key-2026-very-secure

# CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Web Frontend
VITE_API_URL=http://localhost:3001/api/v1
VITE_SOCKET_URL=http://localhost:3001

# Google OAuth 2.0 Client ID (Google Cloud Console)
GOOGLE_CLIENT_ID=954853707879-khbiv8su3of67ih08vfflpj2vanqbj2j.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=954853707879-khbiv8su3of67ih08vfflpj2vanqbj2j.apps.googleusercontent.com

# SMS & Mobile OTP Verification (MSG91 / Console)
SMS_PROVIDER=console # 'console' for local dev, 'msg91' for production
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_FLOW_ID=your_msg91_dlt_template_flow_id
MSG91_SENDER_ID=FLWTRK
ALLOW_CONSOLE_SMS_IN_PRODUCTION=false

