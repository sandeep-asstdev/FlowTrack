# ==========================================
# FlowTrack API Environment Configuration
# ==========================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/flowtrack?schema=public"

# API Server Port
PORT=3001

# Application Environment (development | staging | production)
NODE_ENV=development

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=flowtrack-super-secret-jwt-key-2026-very-secure

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Redis Connection (BullMQ background jobs & cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Vault Storage Path for uploaded documents and evidence
VAULT_STORAGE_PATH=./vault_storage

# ==========================================
# Google OAuth Configuration
# ==========================================
# Google OAuth 2.0 Client ID obtained from Google Cloud Console (APIs & Services -> Credentials)
# Authorized JavaScript origins must include: http://localhost:5173, http://127.0.0.1:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
